---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif';
import '../styles/base.css';
import '../styles/sections.css';
import { profile } from '../data/profile';

const site = 'https://ipul122.github.io/portfolio/';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Anwar U. Sayfulloh | AI/ML Engineer & Geoscience Portfolio';
const desc = 'Anwar Udin Sayfulloh - AI/ML Engineer (Python, PyTorch, XGBoost). End-to-end ML & deep learning projects, DataCamp certified, 1 published paper.';
const ogDesc = 'Machine learning, deep learning and geoscience projects — Python, PyTorch, XGBoost, MLOps. DataCamp certified, 1 published paper.';
const ogImg = `${site}og-cover.png`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: 'AI/ML Engineer focused on end-to-end machine learning, deep learning and geoscience data projects.',
  email: profile.email,
  url: site,
  image: ogImg,
  address: { '@type': 'PostalAddress', addressLocality: 'Bandar Lampung', addressCountry: 'ID' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Institut Teknologi Sumatera (ITERA)' },
    { '@type': 'EducationalOrganization', name: 'Purwadhika Digital Technology School' },
  ],
  knowsAbout: ['Machine Learning', 'Deep Learning', 'Computer Vision', 'Data Analytics', 'MLOps', 'Geophysics'],
  knowsLanguage: ['English', 'Indonesian'],
  sameAs: profile.socials.map((s) => s.href),
};
const nav = [
  ['about', 'About'], ['experience', 'Experience'], ['projects', 'Projects'],
  ['research', 'Research'], ['certifications', 'Certificates'], ['skills', 'Skills'],
  ['education', 'Education'], ['contact', 'Contact'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="author" content={profile.name} />
  <meta name="theme-color" content="#13110f" />
  <link rel="canonical" href={site} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site} />
  <meta property="og:site_name" content="Anwar Udin Sayfulloh — Portfolio" />
  <meta property="og:title" content="Anwar U. Sayfulloh | AI/ML Engineer" />
  <meta property="og:description" content={ogDesc} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Anwar Udin Sayfulloh — AI/ML Engineer portfolio cover" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Anwar U. Sayfulloh | AI/ML Engineer" />
  <meta name="twitter:description" content={ogDesc} />
  <meta name="twitter:image" content={ogImg} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline>
    var d = document.documentElement;
    d.classList.add('js');
    var t = localStorage.getItem('theme');
    d.dataset.theme = t || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  </script>
  <style is:global>
    @media (prefers-reduced-motion: no-preference) {
      .js .line > span, .js .w > span { transform: translateY(115%); }
      .js [data-reveal] { opacity: 0; transform: translateY(24px); }
      /* Failsafe: if the motion script never runs, reveal everything after 2s.
         GSAP's own inline styles take over the moment it does run. */
      .js .line > span, .js .w > span { animation: rescue 0.6s 2s var(--ease) forwards; }
      .js [data-reveal] { animation: rescue 0.6s 2.2s var(--ease) forwards; }
      @keyframes rescue { to { transform: none; opacity: 1; } }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>

  <header class="nav" id="nav">
    <div class="wrap">
      <a class="logo" href="#top" aria-label="Anwar Udin Sayfulloh — back to top">Anwar<span style="color:var(--accent)">.</span></a>
      <nav aria-label="Main navigation">
        <ul id="menu">
          {nav.map(([id, label]) => <li><a class="l" href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
      <div class="nav-tools">
        <button class="icon-btn" id="theme-btn" type="button" aria-label="Toggle light / dark theme">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 0 0 13z" fill="currentColor"/></svg>
        </button>
        <button class="icon-btn" id="menu-btn" type="button" aria-controls="menu" aria-expanded="false">Menu</button>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer>
    <div class="wrap mono muted">
      <span>© 2026 {profile.name}</span>
      <span>Built with Astro</span>
    </div>
  </footer>

  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>
